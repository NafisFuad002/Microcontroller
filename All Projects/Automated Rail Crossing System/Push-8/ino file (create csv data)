int trainSequenceNumber = 0;
String arrivalTimeStr = "--";
String gateOpenTimeStr = "--";
String departureTimeStr = "--";
String gateCloseTimeStr = "--";
String trainSpeedStr = "--";

// Event-moment এ snapshot করা distance মান (live read না করে)
int s1AtArrival = 0;
int s2AtArrival = 0;
int s3AtDeparture = 0;
int s5AtDeparture = 0;

bool cycleHadObstacle = false;

bool previousTrainInsideCrossingLog = false;
bool previousGateClosedLog = false;


int getDistance(byte trigPin, byte echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);

  digitalWrite(trigPin, LOW);

  unsigned long duration = pulseIn(echoPin, HIGH, echoTimeoutUs);

  if (duration == 0) {
    return 600;
  }

  float distanceCm = duration * 0.0343 / 2.0;

  return (int)distanceCm;
}


void moveGate(int newPosition) {
  if (currentGatePosition != newPosition) {
    gateServo.write(newPosition);
    currentGatePosition = newPosition;
  }
}


void openGateNormal() {
  moveGate(gateOpenPosition);
  digitalWrite(greenLight, LOW);       // green ON
  digitalWrite(redLightBuzzer, HIGH);  // red OFF
  digitalWrite(buz, LOW);
}


void openGateForSafety() {
  moveGate(gateOpenPosition);
  digitalWrite(greenLight, HIGH);      // green OFF
  digitalWrite(redLightBuzzer, LOW);   // red ON
  digitalWrite(buz, HIGH);             // buzzer ON
}


void closeGate() {
  moveGate(gateClosePosition);
  digitalWrite(greenLight, HIGH);      // green OFF
  digitalWrite(redLightBuzzer, LOW);   // red ON
  digitalWrite(buz, LOW);
}


void closeGateMultipleTrain() {
  moveGate(gateClosePosition);
  digitalWrite(greenLight, HIGH);      // green OFF
  digitalWrite(redLightBuzzer, LOW);   // red ON
  digitalWrite(buz, LOW);
}


void processArrivalAndSpeed(bool sensor1Active, bool sensor2Active) {
  bool sensor1NewDetection = sensor1Active && !previousSensor1State;
  bool sensor2NewDetection = sensor2Active && !previousSensor2State;

  if (!trainInsideCrossing && !waitingForSensor2 && sensor1NewDetection && !sensor2Active) {
    sensor1DetectionTimeMs = millis();
    waitingForSensor2 = true;
    speedAvailable = false;
  }

  if (!trainInsideCrossing && waitingForSensor2 && sensor2NewDetection) {
    if (sensor1Active) {
      unsigned long sensor2DetectionTimeMs = millis();
      unsigned long elapsedTimeMs = sensor2DetectionTimeMs - sensor1DetectionTimeMs;

      if (elapsedTimeMs > 0 && elapsedTimeMs <= speedTimeoutMs) {
        trainSpeedKmh = (speedSensorGapMeter * 3600.0) / elapsedTimeMs;
        speedAvailable = true;
        trainInsideCrossing = true;
        multipleTrainEmergency = false;
      }
    }

    waitingForSensor2 = false;
  }

  if (waitingForSensor2 && millis() - sensor1DetectionTimeMs > speedTimeoutMs) {
    waitingForSensor2 = false;
    speedAvailable = false;
  }

  previousSensor1State = sensor1Active;
  previousSensor2State = sensor2Active;
}


void processDeparture(bool sensor3Active, bool sensor5Active)
{
  bool sensor3NewDetection = sensor3Active && !previousSensor3State;
  bool sensor5NewDetection = sensor5Active && !previousSensor5State;

  if (!trainInsideCrossing) {
    waitingForSensor5 = false;
    waitingForSensor3Reverse = false;
    previousSensor3State = sensor3Active;
    previousSensor5State = sensor5Active;
    return;
  }

  // ============ স্বাভাবিক ক্রম: sensor3 আগে, sensor5 পরে (normal departure) ============
  if (trainInsideCrossing && !waitingForSensor5 && !waitingForSensor3Reverse && sensor3NewDetection && !sensor5Active) {
    sensor3DetectionTimeMs = millis();
    waitingForSensor5 = true;
  }

  if (trainInsideCrossing && waitingForSensor5 && sensor5NewDetection) {
    if (sensor3Active) {
      trainInsideCrossing = false;
      speedAvailable = false;
      trainCountToday++;
      multipleTrainEmergency = false;
    }

    waitingForSensor5 = false;
  }

  // ============ উল্টো ক্রম: sensor5 আগে, sensor3 পরে (Multiple Train Emergency) ============
  if (trainInsideCrossing && !waitingForSensor5 && !waitingForSensor3Reverse && sensor5NewDetection && !sensor3Active) {
    sensor5DetectionTimeMs = millis();
    waitingForSensor3Reverse = true;
  }

  if (trainInsideCrossing && waitingForSensor3Reverse && sensor3NewDetection) {
    if (sensor5Active) {
      trainInsideCrossing = false;
      speedAvailable = false;
      trainCountToday += 2;
      multipleTrainEmergency = true;
    }

    waitingForSensor3Reverse = false;
  }

  // Timeout
  if (waitingForSensor5 && millis() - sensor3DetectionTimeMs > speedTimeoutMs) {
    waitingForSensor5 = false;
  }

  if (waitingForSensor3Reverse && millis() - sensor5DetectionTimeMs > speedTimeoutMs) {
    waitingForSensor3Reverse = false;
  }

  // ট্রিগার সেন্সর confirm হওয়ার আগেই inactive হলে সাথে সাথে বাতিল (bird protection)
  if (waitingForSensor5 && !sensor3Active) {
    waitingForSensor5 = false;
  }

  if (waitingForSensor3Reverse && !sensor5Active) {
    waitingForSensor3Reverse = false;
  }

  previousSensor3State = sensor3Active;
  previousSensor5State = sensor5Active;
}


void clearLCDLine(byte row) {
  lcd.setCursor(0, row);
  lcd.print("                ");
  lcd.setCursor(0, row);
}


void updateLCD() {
  static unsigned long previousLCDUpdate = 0;

  if (millis() - previousLCDUpdate < 250) {
    return;
  }

  previousLCDUpdate = millis();

  clearLCDLine(0);

  if (waitingForSensor2) {
    lcd.print("Speed measuring");
  }
  else if (speedAvailable) {
    lcd.print("V:");
    lcd.print(trainSpeedKmh, 1);
    lcd.print(" km/h");
  }
  else {
    lcd.print("V: -- km/h");
  }

  clearLCDLine(1);

  if (multipleTrainEmergency) {
    lcd.print("MULTI TRAIN!");
  }
  else if (trainInsideCrossing && obstacleDetected) {
    lcd.print("OBJECT! GATE UP");
  }
  else if (trainInsideCrossing) {
    lcd.print("GATE: CLOSED");
  }
  else {
    lcd.print("GATE: OPEN");
  }
}


// ================== CSV Logging Functions ==================

String getTimeStamp() {
  struct tm timeinfo;
  if (getLocalTime(&timeinfo, 10)) {   // 10ms timeout, loop block করবে না
    char buf[9];
    strftime(buf, sizeof(buf), "%H:%M:%S", &timeinfo);
    return String(buf);
  } else {
    return String(millis() / 1000) + "s";
  }
}


void printCSVHeader() {
  delay(60000);
  Serial.println("Train_No,Train_Detected,Gate_Status,Train_Arrival_Time,Gate_Close_Time,Gate_Open_Time,Train_Departure_Time,S1,S2,S3,S5,Train_Speed_kmh");
}


void printCSVRow() {
  String gateStatus;
  if (multipleTrainEmergency) {
    gateStatus = "MULTI_TRAIN";
  } else if (cycleHadObstacle) {
    gateStatus = "SAFETY_OPEN";
  } else {
    gateStatus = "CLOSED";
  }

  Serial.print(trainSequenceNumber); Serial.print(",");
  Serial.print("Yes"); Serial.print(",");
  Serial.print(gateStatus); Serial.print(",");
  Serial.print(arrivalTimeStr); Serial.print(",");
  Serial.print(gateCloseTimeStr); Serial.print(",");
  Serial.print(gateOpenTimeStr); Serial.print(",");
  Serial.print(departureTimeStr); Serial.print(",");
  Serial.print(s1AtArrival); Serial.print(",");
  Serial.print(s2AtArrival); Serial.print(",");
  Serial.print(s3AtDeparture); Serial.print(",");
  Serial.print(s5AtDeparture); Serial.print(",");
  Serial.println(trainSpeedStr);
}


// একটা ট্রেনের পুরো cycle (arrival -> gate close -> departure -> gate open)
// শেষ হলে তবেই একটা row print হবে, প্রতিটা মানই তার নিজের event-moment এ snapshot করা
void checkAndLogTrainEvents() {
  bool gateClosedNow = (currentGatePosition == gateClosePosition);

  // Train arrival -> নতুন cycle শুরু
  if (trainInsideCrossing && !previousTrainInsideCrossingLog) {
    trainSequenceNumber++;
    arrivalTimeStr = getTimeStamp();
    gateOpenTimeStr = "--";
    departureTimeStr = "--";
    gateCloseTimeStr = "--";
    cycleHadObstacle = false;

    // arrival মুহূর্তের S1, S2 distance snapshot (detectDistance এর মধ্যেই থাকার কথা)
    s1AtArrival = distance1;
    s2AtArrival = distance2;

    if (speedAvailable) {
      trainSpeedStr = String(trainSpeedKmh, 1);
    } else {
      trainSpeedStr = "--";
    }
  }

  // Crossing চলাকালীন কোনো obstacle হলে মনে রাখা (row এ দেখানোর জন্য)
  if (trainInsideCrossing && obstacleDetected) {
    cycleHadObstacle = true;
  }

  // Gate close time capture
  if (gateClosedNow && !previousGateClosedLog) {
    gateCloseTimeStr = getTimeStamp();
  }

  // Train departure -> departure মুহূর্তের S3, S5 distance snapshot
  if (!trainInsideCrossing && previousTrainInsideCrossingLog) {
    departureTimeStr = getTimeStamp();
    s3AtDeparture = distance3;
    s5AtDeparture = distance5;
  }

  // Gate open (departure এর পর) -> cycle সম্পূর্ণ, এখানেই একবার row print হবে
  if (!gateClosedNow && previousGateClosedLog) {
    gateOpenTimeStr = getTimeStamp();
    printCSVRow();
  }

  previousTrainInsideCrossingLog = trainInsideCrossing;
  previousGateClosedLog = gateClosedNow;
}


void sendToBlynk() {
  Blynk.virtualWrite(V0, distance1);
  Blynk.virtualWrite(V1, distance2);
  Blynk.virtualWrite(V2, distance3);
  Blynk.virtualWrite(V3, distance4);
  Blynk.virtualWrite(V4, distance5);

  if (speedAvailable) {
    Blynk.virtualWrite(V5, trainSpeedKmh);
  } else {
    Blynk.virtualWrite(V5, 0);
  }

  Blynk.virtualWrite(V7, trainInsideCrossing ? 1 : 0);
  Blynk.virtualWrite(V8, trainCountToday);
  Blynk.virtualWrite(V11, multipleTrainEmergency ? 1 : 0);

  if (trainInsideCrossing && obstacleDetected) {
    Blynk.virtualWrite(V6, 2);
  } else if (trainInsideCrossing) {
    Blynk.virtualWrite(V6, 0);
  } else {
    Blynk.virtualWrite(V6, 1);
  }
}


BLYNK_WRITE(V9) {
  manualMode = param.asInt();
}

BLYNK_WRITE(V10) {
  manualCloseCommand = param.asInt();
}

BLYNK_WRITE(V12) {
  int buttonPressed = param.asInt();

  if (buttonPressed == 1) {
    multipleTrainEmergency = false;
    trainInsideCrossing = false;
    waitingForSensor5 = false;
    waitingForSensor3Reverse = false;
    waitingForSensor2 = false;
    speedAvailable = false;

    Blynk.virtualWrite(V11, 0);
    Blynk.virtualWrite(V7, 0);
    Blynk.virtualWrite(V6, 1);
  }
}


void checkDailyReset() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    return;
  }

  int currentDay = timeinfo.tm_mday;

  if (lastCheckedDay == -1) {
    lastCheckedDay = currentDay;
    return;
  }

  if (currentDay != lastCheckedDay) {
    trainCountToday = 0;
    lastCheckedDay = currentDay;
    Blynk.virtualWrite(V8, trainCountToday);
  }
}


void setup() {
  pinMode(trig1, OUTPUT);
  pinMode(echo1, INPUT);

  pinMode(trig2, OUTPUT);
  pinMode(echo2, INPUT);

  pinMode(trig3, OUTPUT);
  pinMode(echo3, INPUT);

  pinMode(trig4, OUTPUT);
  pinMode(echo4, INPUT);

  pinMode(trig5, OUTPUT);
  pinMode(echo5, INPUT);

  pinMode(redLightBuzzer, OUTPUT);
  pinMode(greenLight, OUTPUT);
  pinMode(buz, OUTPUT);

  ESP32PWM::allocateTimer(0);
  gateServo.setPeriodHertz(50);
  gateServo.attach(servoPin, 500, 2400);

  Serial.begin(115200);
  delay(1000);          // Serial port stabilize হওয়ার সময় দেওয়া হচ্ছে
  printCSVHeader();

  Wire.begin(21, 22);
  lcd.begin(16, 2);
  lcd.setBacklight(HIGH);

  lcd.setCursor(0, 0);
  lcd.print("Smart Railway");

  lcd.setCursor(0, 1);
  lcd.print("System Starting");

  openGateNormal();
  delay(1500);
  lcd.clear();

  // ================== Blynk শুরু করা (Non-blocking, কোনো Serial message ছাড়া) ==================
  Blynk.config(BLYNK_AUTH_TOKEN);
  WiFi.begin(ssid, pass);

  unsigned long wifiStartAttemptTime = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - wifiStartAttemptTime < 15000) {
    delay(500);
  }

  if (WiFi.status() == WL_CONNECTED) {
    Blynk.connect(5000);
  }

  configTime(gmtOffset_sec, daylightOffset_sec, ntpServer);

  timer.setInterval(1000L, sendToBlynk);
  timer.setInterval(60000L, checkDailyReset);
}


void loop() {
  Blynk.run();
  timer.run();

  distance1 = getDistance(trig1, echo1);
  bool sensor1Active = distance1 <= detectDistance;
  delay(10);
  Blynk.run();

  distance2 = getDistance(trig2, echo2);
  bool sensor2Active = distance2 <= detectDistance;
  delay(10);
  Blynk.run();

  processArrivalAndSpeed(sensor1Active, sensor2Active);

  distance3 = getDistance(trig3, echo3);
  bool sensor3Active = distance3 <= detectDistance;
  delay(10);
  Blynk.run();

  distance4 = getDistance(trig4, echo4);
  bool sensor4Active = distance4 <= detectDistance;
  obstacleDetected = sensor4Active;
  delay(10);
  Blynk.run();

  distance5 = getDistance(trig5, echo5);
  bool sensor5Active = distance5 <= detectDistance;
  delay(10);
  Blynk.run();

  processDeparture(sensor3Active, sensor5Active);

  if (manualMode) {
    if (manualCloseCommand) {
      closeGate();
    } else {
      openGateNormal();
    }
  }
  else {
    if (multipleTrainEmergency) {
      closeGateMultipleTrain();
    }
    else if (trainInsideCrossing) {
      if (obstacleDetected) {
        openGateForSafety();
      }
      else {
        closeGate();
      }
    }
    else {
      openGateNormal();
    }
  }

  updateLCD();
  checkAndLogTrainEvents();
}
