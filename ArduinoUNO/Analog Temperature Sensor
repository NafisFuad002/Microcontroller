int sensorvalue;
int voltage;
float temperature;
void setup()
{
  Serial.begin(9600);
}

void loop()
{
  sensorvalue = analogRead(A0);
  voltage = sensorvalue*5000.0/1023.0;
  temperature = (voltage-500.0)/10.0;
  
  Serial.println("Temperature:");
  Serial.println(temperature);
  
  delay(1000);
}
