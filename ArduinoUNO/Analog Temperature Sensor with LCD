#include <LiquidCrystal_I2C.h>

LiquidCrystal_I2C nff(0x20, 16, 2);
  
int sensorvalue;
int voltage;
float temperature;
void setup()
{
  Serial.begin(9600);
  nff.init();
  nff.backlight();
}

void loop()
{
  sensorvalue = analogRead(A0);
  voltage = sensorvalue*5000.0/1023.0;
  temperature = (voltage-500.0)/10.0;
  
  Serial.println("Temperature:");
  Serial.println(temperature);
  
  nff.setCursor(0,0);
  nff.println("temperature:");
    
  nff.setCursor(0,1);
  nff.print(temperature);
  
  for(int i=0; i<16; i++)
  {
    nff.scrollDisplayRight();    
    delay(100);
  }
  
  nff.clear();
  delay(500);
}
